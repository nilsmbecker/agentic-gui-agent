# Copy to .env (never commit .env). All values have working defaults for a local setup.

# --- Model endpoint (any OpenAI-compatible /v1 API) ---
# Default: GELab-Zero served by the local Ollama app.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gelab-zero-4b-preview
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=180
# Only written to summary.json (Ollama doesn't report it); match what setup_model used
LLM_QUANT=q8_0
# Screenshot sent to the model, squashed to N x N; 0 = full-resolution PNG (about 2x slower)
LLM_IMAGE_SIZE=1024

# --- Android ---
# Path to adb. Leave it commented out to use the Android SDK's default location for your OS
# ADB_PATH=~/Library/Android/sdk/platform-tools/adb
# Emulator console port; first emulator is 5554 (see `adb devices`)
EMULATOR_CONSOLE_PORT=5554

# --- Agent ---
# Seconds to wait after an action before taking the next screenshot
TRANSITION_PAUSE_S=1.5
# Where run logs are written (gitignored)
RUNS_DIR=runs
